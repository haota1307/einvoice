{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@common/configuration/*": ["./src/libs/*"]
    },
    "outDir": "../../dist/out-tsc",
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
